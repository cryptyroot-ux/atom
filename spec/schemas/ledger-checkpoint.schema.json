{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atom.run/spec/v4/schemas/ledger-checkpoint.schema.json",
  "title": "Ledger Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checkpoint_id",
    "ledger_digest",
    "at_event",
    "sealed_at",
    "signature"
  ],
  "properties": {
    "checkpoint_id": {
      "type": "string"
    },
    "ledger_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "at_event": {
      "type": "integer",
      "minimum": 0
    },
    "sealed_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature": {
      "type": "string"
    }
  }
}
