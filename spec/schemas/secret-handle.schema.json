{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atom.run/spec/v4/schemas/secret-handle.schema.json",
  "title": "Secret Handle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "handle_id",
    "secret_id",
    "reference",
    "generation",
    "scope"
  ],
  "properties": {
    "handle_id": {
      "type": "string"
    },
    "secret_id": {
      "type": "string"
    },
    "reference": {
      "type": "string"
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "scope": {
      "type": "string"
    }
  }
}
