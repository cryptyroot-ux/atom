{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atom.run/spec/v4/schemas/credential-set.schema.json",
  "title": "CredentialSet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "set_id",
    "owner",
    "sealed",
    "rotation_policy",
    "created_at"
  ],
  "properties": {
    "set_id": { "type": "string" },
    "owner": { "type": "string" },
    "sealed": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "rotation_policy": {
      "enum": ["MANUAL", "SCHEDULED", "ON_DEMAND"]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
