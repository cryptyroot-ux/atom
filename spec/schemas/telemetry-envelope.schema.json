{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atom.run/spec/v4/schemas/telemetry-envelope.schema.json",
  "title": "Telemetry Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope_id",
    "source",
    "metric",
    "value",
    "sampled_at",
    "labels"
  ],
  "properties": {
    "envelope_id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "metric": {
      "type": "string"
    },
    "value": {
      "type": "number"
    },
    "sampled_at": {
      "type": "string",
      "format": "date-time"
    },
    "labels": {
      "type": "object"
    }
  }
}
