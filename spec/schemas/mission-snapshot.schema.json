{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atom.run/spec/v4/schemas/mission-snapshot.schema.json",
  "title": "Mission Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "mission_id",
    "state_digest",
    "captured_at",
    "replay_offset"
  ],
  "properties": {
    "snapshot_id": {
      "type": "string"
    },
    "mission_id": {
      "type": "string"
    },
    "state_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "replay_offset": {
      "type": "integer",
      "minimum": 0
    }
  }
}
